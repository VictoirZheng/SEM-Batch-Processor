# Actor-Partner Interdependence Model (distinguishable dyads)
# Placeholders ending in _1/_2 are linked automatically: the variables you
# select for X_1 and X_2 are paired by position (person 1 / person 2).

{{Y_1:outcome}} ~ a1*{{X_1:predictor}} + p21*{{X_2:predictor}}
{{Y_2:outcome}} ~ a2*{{X_2}} + p12*{{X_1}}

{{X_1}} ~~ {{X_2}}
{{Y_1}} ~~ {{Y_2}}

actor_diff   := a1 - a2     # distinguishability of actor effects
partner_diff := p21 - p12   # distinguishability of partner effects
